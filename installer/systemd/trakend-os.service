# Trakend OS main service.
# SOURCE OF TRUTH: installer/systemd/trakend-os.service in the Trakend OS repo.
# Installed by installer/build-iso.sh (ISO) and scripts/apply-systemd-units.sh (existing servers).
#
# Notes:
#  - No Requires=/After=docker.service: the array starts Docker itself, and a
#    Requires= dependency would make "stop array" (stop docker) kill the backend.
#  - ConditionPathExists on both build artifacts prevents a crash-loop when a
#    half-finished update left dist/ missing.
#  - ConditionKernelCommandLine=!trakend.safemode=1 guarantees this unit and
#    trakend-safemode.service can never fight over port 80.
[Unit]
Description=Trakend OS Server Management Platform
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/data
StartLimitIntervalSec=300
StartLimitBurst=10
ConditionPathExists=/opt/trakend/os/backend/dist/index.js
ConditionPathExists=/opt/trakend/os/frontend/dist/index.html
ConditionKernelCommandLine=!trakend.safemode=1

[Service]
Type=simple
User=root
WorkingDirectory=/opt/trakend/os
ExecStartPre=/bin/mkdir -p /data/docker /data/mysql /data/db /data/logs /data/backups /data/shares /data/appdata
ExecStart=/usr/bin/node /opt/trakend/os/ws-wrapper.js
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
# Hard defaults FIRST, then .env may override. Never rely on .env for the data paths:
# a missing .env must not silently point the backend at an empty database.
Environment=NODE_ENV=production
Environment=PORT=80
Environment=DATA_DIR=/data
Environment=DB_PATH=/data/db/trakend.db
Environment=LOG_DIR=/data/logs
EnvironmentFile=-/opt/trakend/os/backend/.env

[Install]
WantedBy=multi-user.target
