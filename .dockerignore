# ===========================================
# Trakend OS — Docker Build Context Exclusions
# ===========================================
# Without this file, Docker sends the ENTIRE project
# directory (~1.4 GB+) as build context, causing hangs.
# With it, context drops to ~50 MB.

# Git history is INCLUDED on purpose: the installed /opt/trakend/os must be a
# real git checkout so the in-app updater (git pull --ff-only) works.
# build-iso.sh runs `git gc --aggressive` before embedding it to keep the ISO small.
# (Only large non-git junk is excluded below.)

# Node modules (reinstalled inside Docker)
node_modules
**/node_modules

# Build outputs (rebuilt inside Docker)
dist
**/dist
build
**/build

# Previous ISO output (1.5 GB!)
installer/output
installer/output/*

# Legacy Unraid flash backup — contains shadow/smbpasswd/SSH host keys. Never
# ship it inside the ISO. (It is still in git history; see build-iso.sh rsync exclude.)
unraid old
unraid old/**

# IDE / editor files
.vscode
.idea
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temp files
*.log
build-log.txt
npm-debug.log*

# Documentation (not needed in ISO build)
docs
*.md
!installer/*.md

# Environment files
.env
.env.*
**/.env
**/.env.*

# Test files
**/__tests__
**/*.test.*
**/*.spec.*
coverage
